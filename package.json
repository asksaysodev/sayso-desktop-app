{
  "name": "toastmacos",
  "version": "1.0.0",
  "description": "Electron React Boilerplate App",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "NODE_ENV=development concurrently \"vite\" \"electron electron/main.cjs\"",
    "build": "vite build",
    "package": "npm run build && electron-builder",
    "test": "echo \"Error: no test specified\" && exit 1",
    "kill-port": "lsof -ti :5173 | xargs kill -9 || true"
  },
  "keywords": [
    "electron",
    "react",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "@zoom/meetingsdk": "3.13.2",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "electron-squirrel-startup": "^1.0.1",
    "form-data": "^4.0.2",
    "lodash": "^4.17.21",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.5.3",
    "styled-components": "^6.1.18",
    "wav": "^1.0.2",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^36.2.0",
    "electron-builder": "^24.13.3",
    "supabase": "^2.22.6",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.example.electronreactapp",
    "productName": "Sayso",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "public/assets",
        "to": "assets"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
