{
  "name": "sayso-app",
  "version": "1.2.8",
  "description": "Sayso Desktop App",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/asksaysodev/sayso-desktop-app.git"
  },
  "scripts": {
    "start": "electron .",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev": "NODE_ENV=development concurrently \"vite\" \"npm run build:electron && electron electron/main.js\"",
    "build": "vite build --mode production",
    "build:staging": "vite build --mode staging",
    "clean": "rm -rf dist/ release/ release-staging/ node_modules/.cache electron/native-audio/build .vite",
    "clean:staging": "rm -rf dist/ release-staging/ node_modules/.cache electron/native-audio/build .vite",
    "clean-all": "npm run clean && rm -rf node_modules/ package-lock.json",
    "rebuild-native": "cd electron/native-audio && npx node-gyp rebuild --target=36.9.1 --arch=arm64 --dist-url=https://electronjs.org/headers && cd ../..",
    "rebuild-native-x64": "cd electron/native-audio && npx node-gyp rebuild --target=36.9.1 --arch=x64 --dist-url=https://electronjs.org/headers && cd ../..",
    "rebuild-native-both": "node scripts/rebuild-native-both-archs.js",
    "package": "npm run rebuild-native-both && npm run build:electron && npm run build && electron-builder --publish never",
    "package:staging": "npm run rebuild-native-both && npm run build:electron && npm run build:staging && electron-builder --config build.staging.js --publish never",
    "export": "chmod +x scripts/rebuild-and-package.sh && ./scripts/rebuild-and-package.sh",
    "export:staging": "chmod +x scripts/rebuild-and-package-staging.sh && ./scripts/rebuild-and-package-staging.sh",
    "fresh-export": "npm run clean && npm run export",
    "fresh-export:staging": "npm run clean:staging && npm run export:staging",
    "test": "echo \"Error: no test specified\" && exit 1",
    "kill-port": "lsof -ti :5173 | xargs kill -9 || true"
  },
  "keywords": [
    "electron",
    "react",
    "vite"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sentry/electron": "^7.5.0",
    "axios": "^1.9.0",
    "dotenv": "^16.5.0",
    "electron-log": "^5.1.2",
    "electron-squirrel-startup": "^1.0.1",
    "electron-updater": "^6.1.8",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@electron/remote": "^2.0.7",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/vite-plugin": "^4.6.1",
    "@supabase/supabase-js": "^2.49.4",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@tanstack/react-query": "^5.90.12",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.22",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^8.2.2",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "electron": "^36.4.0",
    "electron-builder": "^24.13.3",
    "google-protobuf": "^3.21.4",
    "lodash": "^4.17.21",
    "lucide-react": "^0.556.0",
    "postcss": "^8.5.6",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-day-picker": "^9.12.0",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.68.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.5.3",
    "shadcn": "^3.5.1",
    "styled-components": "^6.1.18",
    "supabase": "^2.22.6",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "uuid": "^11.1.0",
    "vite": "^5.3.1",
    "zustand": "^5.0.8"
  },
  "build": {
    "appId": "com.asksayso.app",
    "productName": "Sayso",
    "publish": {
      "provider": "github",
      "owner": "asksaysodev",
      "repo": "sayso-desktop-app"
    },
    "beforePack": "scripts/rebuild-native-for-arch.js",
    "afterPack": "scripts/verify-and-fix-native-module.js",
    "afterAllArtifactBuild": "scripts/apply-dmg-background.js",
    "asar": true,
    "asarUnpack": [
      "electron/native-audio/**"
    ],
    "files": [
      "**/*",
      "!release{,/**/*}",
      "!release-staging{,/**/*}",
      "!electron/full_recordings/**/*",
      "!electron/chunks/**/*",
      "!release/**/*",
      "!release-staging/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "public/assets",
        "to": "assets"
      }
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "mac": {
      "artifactName": "${productName}-${version}-${arch}-mac.${ext}",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "We need access to your microphone for audio calls",
        "NSAudioCaptureUsageDescription": "We need access to system audio to create multi-output devices for call recording",
        "LSMinimumSystemVersion": "13.0.0"
      },
      "notarize": {
        "teamId": "AFGHD8M3VK"
      },
      "identity": "AskSayso, Inc. (AFGHD8M3VK)"
    },
    "dmg": {
      "title": "Install Sayso ${version}",
      "background": "assets/dmg-background.tiff",
      "iconSize": 110,
      "window": {
        "width": 600,
        "height": 400
      },
      "contents": [
        {
          "x": 155,
          "y": 255,
          "type": "file"
        },
        {
          "x": 445,
          "y": 255,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
